# AiToEarn Server 环境变量示例
#
# 注意：后端运行时配置通过 YAML 配置文件加载（启动时强制传入 -c 参数）：
#   pnpm nx serve aitoearn-server   # 默认使用 config/local.config.yaml
# 本文件只列出真正由环境变量消费的配置项（seed 脚本、Docker 配置注入）。
# Mongo / Redis / JWT / OSS / AI keys 等运行时配置请修改 config/local.config.yaml，
# 逐项对应关系见文件底部对照表。

# ===== seed 脚本（pnpm nx run aitoearn-server:seed） =====
# MongoDB 连接串（默认对应本地 docker compose / 本地 mongod）
MONGO_URI=mongodb://admin:password@localhost:27017/?authSource=admin&directConnection=true
# 主库名 / channel 库名（对应 config 中 mongodb.dbName / channel.channelDb.dbName）
DB_NAME=aitoearn
CHANNEL_DB_NAME=aitoearn_channel
# JWT 签名密钥，必须与 config/local.config.yaml 的 auth.secret 一致
JWT_SECRET=change-this-jwt-secret
# demo 账号邮箱（user 集合无密码字段，seed 完成后输出 JWT 登录 token）
DEMO_MAIL=demo@aitoearn.dev

# ===== Docker 部署配置注入（本地开发可忽略） =====
# 把环境变量内容写成配置文件，供容器内 -c 读取（可编号 WRITE_FILE_0_PATH / WRITE_FILE_1_PATH ...）
# WRITE_FILE_0_PATH=/app/config.yaml
# WRITE_FILE_0_CONTENT=<完整 config.yaml 内容>

# ===== 运行时配置对照表（改 config/local.config.yaml） =====
# MongoDB .............. mongodb.uri / mongodb.dbName
# Channel 库 ........... channel.channelDb.uri / channel.channelDb.dbName
# Redis ................ redis.host / redis.port / redis.password（redlock.redis 同）
# JWT / 内部令牌 ........ auth.secret / auth.internalToken
# OSS / S3 ............. assets.endpoint / assets.accessKeyId / assets.secretAccessKey / assets.bucketName
# AI 服务 .............. aiClient.baseUrl / aiClient.token
# Relay ................ relay.serverUrl（中国版 https://aitoearn.cn/api，国际版 https://aitoearn.ai/api）/ relay.apiKey
# 平台 OAuth ........... channel.<platform>.clientId / clientSecret / redirectUri
