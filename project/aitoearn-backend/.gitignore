# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# 官方插件产物需要随仓库分发（plugins/<id>/dist/*.mjs），因此放开 plugins 下的 dist
!plugins/**/dist/
!plugins/**/dist/**
# 打包产物与签名由 CI 生成，不入库
plugins/**/*.aitpkg
plugins/**/*.sig

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

local.config.js
local.config.yaml
.prettierignore
.prettierrc
.claude-session
.claude-code-router
.claude.json

# local docker
docker-compose.yml
nginx/
vitest.config.*.timestamp*
/.claude/settings.local.json
.claude/scheduled_tasks.lock

